# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Public URL of the site (used for metadata, sitemap and robots.txt).
# In production set this to https://bhoomi.builders
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where form submissions are delivered. Each receives a JSON POST:
#   contact:    { type, name, email, phone, message, submittedAt, source }
#   newsletter: { type, email, submittedAt, source }
# The site only shows success after the endpoint answers with a 2xx status.
# Works with Formspree (https://formspree.io/f/<id>), Zapier/Make webhooks,
# Basin, or your own API. Defaults below point at the local mock (npm run mock).
CONTACT_WEBHOOK_URL=http://localhost:4010/contact
NEWSLETTER_WEBHOOK_URL=http://localhost:4010/newsletter

# Optional: sent as "Authorization: Bearer <secret>" with every submission.
FORMS_WEBHOOK_SECRET=

# Optional: how long to wait for the endpoint before failing (ms).
FORMS_TIMEOUT_MS=10000
